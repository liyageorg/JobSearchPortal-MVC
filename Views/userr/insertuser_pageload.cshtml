@model JOB_SEARCH.Models.userins
@{
    ViewBag.Title = "insertuser_pageload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .register-box {
        width: 45%;
        margin: 40px auto;
        padding: 35px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0px 0px 15px rgba(0,0,0,0.1);
    }

        .register-box h2 {
            text-align: center;
            margin-bottom: 30px;
            color: #2c3e50;
        }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        font-weight: bold;
        color: #34495e;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        margin-top: 5px;
    }

    .btn-submit {
        width: 100%;
        padding: 12px;
        background-color: #007bff;
        border: none;
        color: white;
        font-size: 16px;
        border-radius: 6px;
        cursor: pointer;
    }

        .btn-submit:hover {
            background-color: #0056b3;
        }

    .text-danger {
        color: red;
        font-size: 14px;
    }

    .qual-box label {
        margin-right: 15px;
    }

    .msg {
        text-align: center;
        color: green;
        font-weight: bold;
    }
</style>

<div class="register-box">

    <h2>User Registration</h2>

    @using (Html.BeginForm("insertuser_click", "userr", FormMethod.Post))
    {

        <div class="form-group">
            <label>Name</label>
            @Html.TextBoxFor(m => m.uname, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.uname, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.uphone, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.uphone, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Email</label>
            @Html.TextBoxFor(m => m.uemail, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.uemail, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Address</label>
            @Html.TextAreaFor(m => m.uaddress, new { @class = "form-control", rows = 3 })
            @Html.ValidationMessageFor(m => m.uaddress, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Qualification</label>

            <div class="qual-box">
                @foreach (var item in Model.MyFavouriteQual)
                {
                    <label>
                        <input type="checkbox"
                               value="@item.Value"
                               checked="@item.IsChecked"
                               name="selectedQual"
                               id="@item.Value" />

                        @Html.Raw(item.Text)
                    </label>
                }
            </div>
        </div>

        <div class="form-group">
            <label>Experience</label>
            @Html.TextAreaFor(m => m.uexp, new { @class = "form-control", rows = 3 })
            @Html.ValidationMessageFor(m => m.uexp, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Skills</label>
            @Html.TextAreaFor(m => m.uskill, new { @class = "form-control", rows = 3 })
            @Html.ValidationMessageFor(m => m.uskill, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Username</label>
            @Html.TextBoxFor(m => m.username, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.username, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Password</label>
            @Html.PasswordFor(m => m.password, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.password, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <input type="submit" value="Register" class="btn-submit" />
        </div>

        <div class="msg">
            @Html.DisplayFor(m => m.msg)
        </div>
    }

</div>