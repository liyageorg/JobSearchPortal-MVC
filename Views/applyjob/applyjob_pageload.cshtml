@model JOB_SEARCH.Models.applyjob

@{
    ViewBag.Title = "applyjob_pageload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Apply for Job</h2>

@using (Html.BeginForm("applyjob_click", "applyjob", FormMethod.Post,
    new { enctype = "multipart/form-data" }))
{
    <div>
        <label>Upload Resume</label>
    </div>

    <div>
        <input type="file" name="file" required />
    </div>

    <br />

    <div>
        <input type="submit" value="Apply Now" class="btn btn-primary" />
    </div>

    <div>
        @Html.DisplayFor(m => m.msg)
    </div>
}