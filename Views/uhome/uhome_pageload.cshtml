@model JOB_SEARCH.Models.uhome
@{
    ViewBag.Title = "uhome_pageload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>uhome_pageload</h2>

<style>
    .hero-section {
        width: 90%;
        margin: 30px auto;
        background: linear-gradient(to right, #007bff, #00bcd4);
        padding: 40px;
        border-radius: 15px;
        color: white;
        text-align: center;
    }

        .hero-section h1 {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .hero-section p {
            font-size: 18px;
        }

    .job-container {
        width: 95%;
        margin: 30px auto;
    }

    .job-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        box-shadow: 0px 0px 15px rgba(0,0,0,0.1);
        border-radius: 10px;
        overflow: hidden;
    }

        .job-table th {
            background-color: #2c3e50;
            color: white;
            padding: 15px;
            text-align: left;
        }

        .job-table td {
            padding: 14px;
            border-bottom: 1px solid #eee;
        }

        .job-table tr:hover {
            background-color: #f5f9ff;
        }

    .apply-btn {
        background-color: #28a745;
        color: white;
        padding: 8px 15px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }

        .apply-btn:hover {
            background-color: #218838;
            color: white;
            text-decoration: none;
        }

    .nodata {
        text-align: center;
        color: red;
        font-weight: bold;
        padding: 20px;
    }
</style>

<div class="hero-section">
    <h1>Find Your Dream Job</h1>
    <p>Explore latest job opportunities from top companies</p>
</div>

<div class="job-container">

    <table class="job-table">

        <tr>
            <th>Job Role</th>
            <th>Description</th>
            <th>Location</th>
            <th>Salary</th>
            <th>Qualification</th>
            <th>Experience</th>
            <th>Last Date</th>
            <th>Action</th>
        </tr>

        @if (Model.selectjob.Count > 0)
        {
            foreach (var item in Model.selectjob)
            {
                <tr>

                    <td>@item.job_title</td>

                    <td>@item.job_desc</td>

                    <td>@item.location</td>

                    <td>@item.salary</td>

                    <td>@item.qualification</td>

                    <td>@item.experience</td>

                    <td>
                        @item.last_date.ToString("dd-MM-yyyy")
                    </td>

                    <td>
                        @Html.ActionLink(
                            "Apply Now",
                            "ApplyNow",
                            "uhome",
                            new { id = item.job_id },
                            new { @class = "apply-btn" }
                        )
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="nodata">
                    No Jobs Available
                </td>
            </tr>
        }

    </table>

</div>

