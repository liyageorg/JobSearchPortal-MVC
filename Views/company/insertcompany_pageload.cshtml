@model JOB_SEARCH.Models.cmpins
@{
    ViewBag.Title = "insertcompany_pageload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .company-box {
        width: 45%;
        margin: 40px auto;
        padding: 35px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0px 0px 15px rgba(0,0,0,0.1);
    }

        .company-box h2 {
            text-align: center;
            margin-bottom: 30px;
            color: #2c3e50;
        }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        font-weight: bold;
        color: #34495e;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        margin-top: 5px;
    }

    .btn-submit {
        width: 100%;
        padding: 12px;
        background-color: #28a745;
        border: none;
        color: white;
        font-size: 16px;
        border-radius: 6px;
        cursor: pointer;
    }

        .btn-submit:hover {
            background-color: #218838;
        }

    .text-danger {
        color: red;
        font-size: 14px;
    }

    .msg {
        text-align: center;
        color: green;
        font-weight: bold;
        margin-top: 15px;
    }
</style>

<div class="company-box">

    <h2>Company Registration</h2>

    @using (Html.BeginForm("insertcompany_click", "company", FormMethod.Post))
    {

        <div class="form-group">
            <label>Name</label>
            @Html.TextBoxFor(m => m.cname, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.cname, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Email</label>
            @Html.TextBoxFor(m => m.cemail, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.cemail, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.cphone, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.cphone, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Description</label>
            @Html.TextAreaFor(m => m.cdesc, new { @class = "form-control", rows = 4 })
            @Html.ValidationMessageFor(m => m.cdesc, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Address</label>
            @Html.TextAreaFor(m => m.caddress, new { @class = "form-control", rows = 3 })
            @Html.ValidationMessageFor(m => m.caddress, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Username</label>
            @Html.TextBoxFor(m => m.cusername, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.cusername, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Password</label>
            @Html.PasswordFor(m => m.cpassword, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.cpassword, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <input type="submit" value="Register Company" class="btn-submit" />
        </div>

        <div class="msg">
            @Html.DisplayFor(m => m.msg)
        </div>
    }

</div>