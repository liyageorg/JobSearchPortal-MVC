    <FunctionImportMapping FunctionImportName="sp_cmpreg" FunctionName="JOB_SEARCHModel.Store.sp_cmpreg" />
    <FunctionImportMapping FunctionImportName="sp_countid" FunctionName="JOB_SEARCHModel.Store.sp_countid" />
